/* ============================================================
   СТАТИСТИКА — ЗАГЛУШКА (аналог get_standoff_stats)
   ============================================================ */
async function getStandoffStats(playerId) {
  // Имитация задержки сети
  await new Promise(r => setTimeout(r, 900));
  return {
    nickname: `PLAYER_${playerId}`,
    mmr: "4500",
    hours: "120",
    level: "10",
    kd: "1.42",
    winrate: "58%",
    matches: "342",
    status: "DEMO"
  };
}

/* ============================================================
   ОТПРАВКА ID
   ============================================================ */
async function submitPlayerId() {
  const input = document.getElementById("playerIdInput");
  const playerId = input.value.trim();

  // Валидация: только цифры
  if (!/^\d+$/.test(playerId)) {
    document.getElementById("errorText").textContent = "ID должен состоять только из цифр.";
    showScreen("error");
    if (tg?.HapticFeedback) tg.HapticFeedback.notificationOccurred("error");
    return;
  }

  // Экран загрузки
  document.getElementById("loadingText").textContent = `Ищу игрока ${playerId}...`;
  showScreen("loading");
  if (tg?.HapticFeedback) tg.HapticFeedback.impactOccurred("medium");

  try {
    const stats = await getStandoffStats(playerId);

    document.getElementById("resNick").textContent   = stats.nickname;
    document.getElementById("resLevel").textContent  = "LVL " + stats.level;
    document.getElementById("resId").textContent     = playerId;
    document.getElementById("resMmr").textContent    = stats.mmr;
    document.getElementById("resKd").textContent     = stats.kd;
    document.getElementById("resWr").textContent     = stats.winrate;
    document.getElementById("resMatches").textContent= stats.matches;
    document.getElementById("resHours").textContent  = stats.hours;
    document.getElementById("resStatus").textContent = stats.status;

    showScreen("result");
    input.value = "";
    if (tg?.HapticFeedback) tg.HapticFeedback.notificationOccurred("success");

  } catch (e) {
    console.error("Ошибка получения статы:", e);
    document.getElementById("errorText").textContent = "Не удалось получить статистику. Попробуй позже.";
    showScreen("error");
    if (tg?.HapticFeedback) tg.HapticFeedback.notificationOccurred("error");
  }
}

/* Enter в поле ввода */
document.getElementById("playerIdInput").addEventListener("keydown", e => {
  if (e.key === "Enter") submitPlayerId();
});

/* ============================================================
   TOAST
   ============================================================ */
let toastTimer;
function showToast(msg) {
  const t = document.getElementById("toast");
  t.textContent = msg;
  t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove("show"), 1800);
}

/* ============================================================
   УПРАВЛЕНИЕ ИСТОРИЕЙ (аппаратная кнопка Android)
   ============================================================ */
window.addEventListener("popstate", () => {
  if (currentScreen !== "menu") {
    goBack();
    history.pushState(null, "", location.href);
  }
});
history.pushState(null, "", location.href);

/* ============================================================
   СВАЙП НАЗАД (жест)
   ============================================================ */
let touchStartX = 0;
document.addEventListener("touchstart", e => {
  touchStartX = e.changedTouches[0].screenX;
}, { passive: true });

document.addEventListener("touchend", e => {
  const dx = e.changedTouches[0].screenX - touchStartX;
  if (dx > 80 && currentScreen !== "menu" && touchStartX < 40) {
    goBack();
  }
}, { passive: true });
</script>

