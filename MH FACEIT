  tg.expand();
  tg.setHeaderColor("#000000");
  tg.setBackgroundColor("#000000");
  const u = tg.initDataUnsafe?.user;
  if (u) {
    document.getElementById("userName").textContent =
      [u.first_name, u.last_name].filter(Boolean).join(" ") || u.username || "гость";
  }
}

/* ============================================================
   НАВИГАЦИЯ
   ============================================================ */
let currentScreen = "menu";
const history = [];

function showScreen(name, skipHistory = false) {
  if (!skipHistory && currentScreen !== name) {
    history.push(currentScreen);
  }
  document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
  const el = document.getElementById("screen-" + name);
  if (el) el.classList.add("active");
  currentScreen = name;
  window.scrollTo({ top: 0, behavior: "smooth" });

  if (tg?.HapticFeedback) tg.HapticFeedback.impactOccurred("light");
}

function goBack() {
  const prev = history.pop() || "menu";
  showScreen(prev, true);
}

/* Кнопка "Назад" Telegram */
if (tg?.BackButton) {
  tg.BackButton.onClick(() => {
    if (currentScreen !== "menu") goBack();
  });
  // Показываем кнопку назад только вне меню
  const observer = new MutationObserver(() => {
    if (currentScreen === "menu") tg.BackButton.hide();
    else tg.BackButton.show();
  });
  observer.observe(document.body, { childList: true, subtree: true, attributes: true });
}

