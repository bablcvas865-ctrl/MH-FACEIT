<style>
  :root {
    --bg: #000000;
    --bg-soft: #0d0d0d;
    --bg-card: #141414;
    --line: #2a2a2a;
    --text: #f5f5f5;
    --text-dim: #9a9a9a;
    --accent: #ffffff;
    --danger: #ff4d4d;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  html, body {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  body {
    padding: 16px 14px 100px;
    background:
      radial-gradient(circle at 20% 0%, #1a1a1a 0%, transparent 55%),
      radial-gradient(circle at 80% 100%, #161616 0%, transparent 55%),
      var(--bg);
  }

  /* ---------- АНИМАЦИИ ---------- */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .screen {
    display: none;
    animation: fadeIn 0.35s ease;
  }
  .screen.active { display: block; }

  /* ---------- HEADER ---------- */
  .header {
    text-align: center;
    margin-bottom: 18px;
  }
  .header .line {
    color: var(--line);
    letter-spacing: 1px;
    font-size: 11px;
    overflow: hidden;
    white-space: nowrap;
  }
  .header .title {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 4px;
    margin: 8px 0;
    text-transform: uppercase;
  }
  .header .title .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: middle;
    margin: 0 8px;
    animation: pulse 2s infinite;
  }
  .header .subtitle {
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* ---------- CARD ---------- */
  .card {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px;
    margin-bottom: 14px;
    animation: slideUp 0.4s ease;
  }

  .card-title {
    font-size: 12px;
    letter-spacing: 3px;
    color: var(--text-dim);
    text-transform: uppercase;
    text-align: center;
    margin-bottom: 14px;
  }

  .divider {
    color: var(--line);
    font-size: 10px;
    letter-spacing: 1px;
    overflow: hidden;
    white-space: nowrap;
    text-align: center;
    margin: 12px 0;
  }

  /* ---------- TEXT ---------- */
  .greeting {
    font-size: 15px;
    margin-bottom: 12px;
  }
  .greeting b { color: var(--accent); }

  .info-line {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text);
    margin: 6px 0;
    line-height: 1.4;
  }
  .info-line .bullet {
    color: var(--text-dim);
    font-size: 10px;
  }

  /* ---------- STATS GRID ---------- */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 10px;
  }
  .stat-box {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px;
    text-align: center;
    transition: 0.2s;
  }
  .stat-box:active { transform: scale(0.97); }
  .stat-box .label {
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--text-dim);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .stat-box .value {
    font-size: 18px;
    font-weight: 800;
    color: var(--accent);
  }

  .profile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .profile-head .nick {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1px;
  }
  .profile-head .level {
    background: var(--accent);
    color: #000;
    font-weight: 800;
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 20px;
  }

  .mono {
    font-family: "SF Mono", "Roboto Mono", monospace;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 13px;
  }

  /* ---------- BUTTONS ---------- */
  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 15px;
    margin-bottom: 10px;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 14px;
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: 0.2s;
    font-family: inherit;
  }
  .btn:active {
    transform: scale(0.98);
    background: #1e1e1e;
  }
  .btn.primary {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
  }
  .btn.primary:active { background: #d9d9d9; }
  .btn-row {
    display: flex;
    gap: 10px;
  }
  .btn-row .btn { margin-bottom: 10px; }

  .btn-mini {
    padding: 12px;
    font-size: 12px;
    letter-spacing: 1px;
    margin-bottom: 0;
  }

  /* ---------- SPONSORS ---------- */
  .sponsor-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 12px;
    margin-bottom: 8px;
  }
  .sponsor-item .icon {
    font-size: 22px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .sponsor-item .name {
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 1px;
  }

  /* ---------- INPUT ---------- */
  .input-wrap {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }
  .input-wrap input {
    flex: 1;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px;
    color: var(--text);
    font-size: 16px;
    font-family: inherit;
    outline: none;
    transition: 0.2s;
  }
  .input-wrap input:focus {
    border-color: var(--accent);
  }
  .input-wrap input::placeholder { color: #555; }

  /* ---------- LOADER ---------- */
  .loader {
    width: 42px;
    height: 42px;
    border: 3px solid var(--line);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 20px auto;
  }
  .loading-text {
    text-align: center;
    color: var(--text-dim);
    font-size: 13px;
    letter-spacing: 1px;
  }

  /* ---------- ERROR ---------- */
  .error-box {
    border-color: var(--danger);
  }
  .error-box .card-title { color: var(--danger); }

  /* ---------- FOOTER ---------- */
  .footer {
    text-align: center;
    font-size: 10px;
    color: #444;
    letter-spacing: 2px;
    margin-top: 20px;
    text-transform: uppercase;
  }

  /* ---------- TOAST ---------- */
  .toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: var(--accent);
    color: #000;
    padding: 12px 22px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    opacity: 0;
    transition: 0.3s;
    z-index: 999;
    pointer-events: none;
  }
  .toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>
</head>
